# ───────── WAWA PHOTOBOOTH — variables d'environnement (NE JAMAIS COMMITER .env) ─────────
# Génération des secrets :  npm run gen-secrets      |  Hash du mot de passe admin :  npm run hash-password

# ── Stockage ────────────────────────────────────────────────────────────────────────────
# Production : supabase. Développement local : file (refusé automatiquement sur Vercel/production).
STORAGE_DRIVER=supabase
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=                # clé SERVEUR uniquement — jamais dans le JS client
DATA_ENCRYPTION_KEY=                      # 32 octets en base64 (chiffrement AES-256-GCM des données personnelles)

# ── Sessions / anti-abus ─────────────────────────────────────────────────────────────────
SESSION_SECRET=                           # >= 32 caractères aléatoires
SESSION_VERSION=1                         # incrémenter pour déconnecter toutes les sessions admin
IP_HASH_SECRET=                           # HMAC des adresses IP (jamais stockées en clair)
SITE_ORIGIN=https://www.example.com       # origine(s) autorisée(s) pour les POST, séparées par des virgules
MIN_FILL_MS=4000                          # délai minimal de remplissage (anti-bot)

# ── Administration (/admin) ──────────────────────────────────────────────────────────────
# Mode recommandé (production) : Supabase Auth. Dès que SUPABASE_PUBLISHABLE_KEY est défini, la connexion se fait avec
# le compte Supabase (Authentication > Users) + code TOTP (double authentification activée à la 1re connexion).
# Seuls les e-mails présents dans la table public.admin_users sont admis (voir supabase/migrations/004_admin_users.sql).
SUPABASE_PUBLISHABLE_KEY=                 # clé publique « publishable » (Project Settings > API Keys). PAS la clé service_role.
# Mode de secours / développement local (utilisé seulement si SUPABASE_PUBLISHABLE_KEY est vide) :
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=                      # sortie de `npm run hash-password`
ADMIN_TOTP_SECRET=                        # base32 — obligatoire en production (MFA)
# ADMIN_ALLOW_NO_MFA=true                 # développement local uniquement

# ── E-mails (Resend) — optionnel : sans clé, aucun e-mail n'est envoyé et le site l'indique ──
RESEND_API_KEY=
EMAIL_FROM="WAWA PHOTOBOOTH <demandes@votre-domaine>"
NOTIFY_EMAIL_TO=                          # destinataire(s) de l'équipe, séparés par des virgules
CLIENT_ACK_EMAIL=false                    # true : accusé de réception au client (contient seulement la référence)

# ── Conservation RGPD (purge hebdomadaire via Vercel Cron) ───────────────────────────────
CRON_SECRET=                              # Vercel l'envoie en Authorization: Bearer
RETENTION_MONTHS=                         # À VALIDER avec Wawa Photobooth ; vide = aucune suppression automatique
